### REST Client HTTP Requests for testing Sales and General Balance
### Use this with the VS Code REST Client extension or copy the JSON payloads.
### Since the database is empty, execute these steps in order to populate the prerequisite data.

@baseUrl = http://localhost:8080
@empresaId = E001
@usuario = admin

#################################################################
# PASO 1: CREAR TIPO DE DOCUMENTO DE IDENTIDAD
#################################################################
# @name crearTipoDocIdentidad
POST {{baseUrl}}/api/tiposdocumento
Content-Type: application/json

{
  "nombre": "DNI"
}

###

#################################################################
# PASO 2: CREAR CLIENTE (Requiere tipDocIdenId del Paso 1, ej: 1)
#################################################################
# @name crearCliente
POST {{baseUrl}}/api/clientes
Content-Type: application/json

{
  "clienDescripcion": "Cliente de prueba",
  "clienRazSoc": "Pruebas S.A.C.",
  "clienNomCor": "Pruebas",
  "clienSiglas": "PRU",
  "tipDocIdenId": 1,
  "clienDoc": "10203040",
  "clienRegCom": "REG-01",
  "clienDireccion": "Av. Principal 123",
  "clienTelef01": "555-1234",
  "clienCelular": "999888777",
  "clienMail": "cliente@pruebas.com",
  "clienWeb": "www.pruebas.com",
  "clienContacto": "Juan Pérez",
  "clienFecIng": "2026-07-08T10:00:00",
  "clienEstado": "A",
  "clienGiro": "Comercio",
  "ctaCteId": 1,
  "dptoGeoId": "15",
  "provGeoId": "01",
  "distGeoId": "01",
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:00:00",
  "hrsSistema": "10:00:00"
}

###

#################################################################
# PASO 3: CREAR COMPROBANTE DE PAGO
#################################################################
# @name crearComprobantePago
POST {{baseUrl}}/api/comprobantespago
Content-Type: application/json

{
  "id": "01",
  "comPagDescripcion": "Factura",
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:00:00",
  "hrsSistema": "10:00:00"
}

###

#################################################################
# PASO 4: CREAR DOCUMENTO (Requiere comPagId del Paso 3, ej: "01")
#################################################################
# @name crearDocumento
POST {{baseUrl}}/api/documentos
Content-Type: application/json

{
  "id": "01",
  "docDescripcion": "Factura de Venta",
  "docDesCorta": "FAC",
  "docAbrev": "F",
  "docEstado": true,
  "comPagId": "01",
  "docNumDigSerie": 4,
  "docNumDigNumero": 8,
  "docAfaNumerico": true,
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:00:00",
  "hrsSistema": "10:00:00"
}

###

#################################################################
# PASO 5: CREAR MONEDA
#################################################################
# @name crearMoneda
POST {{baseUrl}}/api/monedas
Content-Type: application/json

{
  "monedaDescripcion": "Soles",
  "monedaAbrev": "S/.",
  "monedaEst": true,
  "monedaAbrevSunat": "PEN",
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:00:00",
  "hrsSistema": "10:00:00"
}

###

#################################################################
# PASO 6: CREAR LABORATORIO
#################################################################
# @name crearLaboratorio
POST {{baseUrl}}/api/laboratorios
Content-Type: application/json

{
  "labDescripcion": "Laboratorio Genérico",
  "labEstado": true,
  "codlab": "LAB01",
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:00:00",
  "hrsSistema": "10:00:00"
}

###

#################################################################
# PASO 7: CREAR FAMILIA DE PRODUCTO
#################################################################
# @name crearFamiliaProducto
POST {{baseUrl}}/api/familias-producto
Content-Type: application/json

{
  "famDescripcion": "Medicamentos",
  "famEstado": true,
  "codfam": "FAM01",
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:00:00",
  "hrsSistema": "10:00:00"
}

###

#################################################################
# PASO 8: CREAR PRODUCTO (Requiere labId=1, famId=1, monedaId=1)
#################################################################
# @name crearProducto
POST {{baseUrl}}/api/productos
Content-Type: application/json

{
