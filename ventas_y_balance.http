###

#################################################################
# PASO 9: CREAR VENTA CON DETALLES ANIDADOS
#################################################################
# @name crearVenta
# Usa: clienId=1, docId="01", monedaId=1 del paso anterior.
# El detalle usa: iteAlmId=1 (el producto creado).
POST {{baseUrl}}/api/ventas
Content-Type: application/json

{
  "empresaId": "{{empresaId}}",
  "unidComId": 1,
  "docId": "01",
  "vtaCabNumComp": "F001-000099",
  "clienId": 1,
  "monedaId": 1,
  "vtaCabFecha": "2026-07-08T10:30:00",
  "vtaValCamb": 3.75,
  "vtaCabAccImp": "S",
  "vtaComAccAnu": "N",
  "condComId": 1,
  "vtaCabEstCanc": "C",
  "vtaCabCierre": "N",
  "vtaCabActPlla": "N",
  "vtaCabAfecDetrac": "N",
  "vtaCabContDetrac": "N",
  "tipOpeComId": 1,
  "vtaCabValorVta": 1271.19,
  "vtaCabValorVtaExo": 0.00,
  "vtaCabValIGV": 228.81,
  "vtaCabValISC": 0.00,
  "vtaCabValTotal": 1500.00,
  "vtaCabValMonPago": 1500.00,
  "vtaCabValVuelto": 0.00,
  "vtaCabNamePaciente": "Paciente de Prueba",
  "usrSistema": "{{usuario}}",
  "fecSistema": "2026-07-08T10:30:00",
  "hrsSistema": "10:30:00",
  "vtaCabDsctoGlobal": 0.00,
  "vtaCabFechaVcto": "2026-08-08T10:30:00",
  "detallesVenta": [
    {
      "empresaId": "{{empresaId}}",
      "unidComId": 1,
      "docId": "01",
      "vtaCabNumComp": "F001-000099",
      "iteAlmId": 1,
      "vtaDetCodref": 1,
      "vtaDetItem": "Paracetamol 500mg",
      "vtaDetCantidad": 10.00,
      "vtaDetPrecUnit": 150.00,
      "vtaDetValorVta": 1271.19,
      "vtaDetValIGV": 228.81,
      "vtaDetValISC": 0.00,
      "vtaDetValTot": 1500.00,
      "tipVtaId": 1,
      "tipAlmId": 1,
      "almacenId": 1,
      "vtaDetFracUni": 1,
      "vtaDetCantFrac": 0,
      "usrSistema": "{{usuario}}",
      "fecSistema": "2026-07-08T10:30:00",
      "hrsSistema": "10:30:00",
      "vtaDetValIna": 0.00
    }
  ]
}

###

#################################################################
# PASO 10: OBTENER TODAS LAS VENTAS (GET)
#################################################################
GET {{baseUrl}}/api/ventas
Accept: application/json

###

#################################################################
# PASO 11: OBTENER VENTA ESPECÍFICA POR ID (GET)
# Reemplaza el id '1' por el ventaId devuelto al crear la venta.
#################################################################
GET {{baseUrl}}/api/ventas/1
Accept: application/json

###

#################################################################
# PASO 12: CONSULTAR BALANCE GENERAL POR PERIODO (GET)
# Devuelve saldos de cuentas agrupados.
#################################################################
GET {{baseUrl}}/api/balance-general?empresaId={{empresaId}}&ano=2026&mes=7
Accept: application/json

###

#################################################################
# PASO 13: CONSULTAR BALANCE GENERAL POR ASIENTO ESPECÍFICO (GET)
# Reemplaza '456' por el diaCabCompId retornado en la creación de la venta.
#################################################################
GET {{baseUrl}}/api/balance-general/456
Accept: application/json
